[
 {"term": "EVA", "expansion": "extravehicular activity", "aliases": ["e v a"], "normalize": false, "category": "mission", "definition": "a spacewalk: any time the crew member is outside the lander in the suit", "intents": ["get_eva_elapsed_time"], "example": ["how long into the EVA are we", "how long have I been out on this spacewalk"], "source": "mission description 1, 2"},
 {"term": "xEVA", "expansion": "exploration extravehicular activity", "aliases": ["x eva", "ex eva"], "normalize": true, "category": "mission", "definition": "NASA's exploration spacewalk program that sponsors SUITS", "intents": [], "example": ["xEVA wants the camera up at every station", "the exploration spacewalk office wants the camera set up at every stop"], "source": "mission description 1"},
 {"term": "EV", "expansion": "extravehicular crew member", "aliases": ["e v"], "normalize": true, "category": "mission", "definition": "the suited crew member doing the spacewalk", "intents": [], "example": ["EV is at the rover", "the suited crew member is standing at the rover"], "source": "mission description 2a"},
 {"term": "EV1", "expansion": "extravehicular crew member one", "aliases": ["ev-1", "ev 1", "ev one", "e v one", "e v 1", "eve one"], "normalize": true, "category": "mission", "definition": "the first suited crew member; the one wearing our display", "intents": [], "example": ["EV1 verify umbilical connection", "first crew member, check that your umbilical is connected"], "source": "mission description appendix a"},
 {"term": "EV2", "expansion": "extravehicular crew member two", "aliases": ["ev-2", "ev 2", "ev two", "e v two", "e v 2", "eve two"], "normalize": true, "category": "mission", "definition": "the second suited crew member", "intents": ["Get_coordinates"], "example": ["where's EV2", "where is the second crew member right now"], "source": "mission description 3b figure"},
 {"term": "IV", "expansion": "intravehicular crew member", "aliases": ["i v"], "normalize": false, "category": "mission", "definition": "the crew member who stays inside and supports the spacewalker", "intents": [], "example": ["IV is reading the procedure to you", "the crew member inside is reading the steps out loud"], "source": "general eva ops"},
 {"term": "MCC", "expansion": "mission control center", "aliases": ["m c c"], "normalize": true, "category": "mission", "definition": "ground team in Houston watching telemetry and advising the crew", "intents": [], "example": ["MCC copies all", "mission control heard everything you said"], "source": "mission description 3e"},
 {"term": "CAPCOM", "expansion": "capsule communicator", "aliases": ["cap com"], "normalize": false, "category": "mission", "definition": "the one person in mission control who talks to the crew", "intents": [], "example": ["CAPCOM says press on to the next station", "the ground voice says keep going to the next stop"], "source": "apollo 15 transcript"},
 {"term": "Houston", "expansion": "mission control", "aliases": [], "normalize": false, "category": "mission", "definition": "call sign for mission control; often opens a radio call", "intents": [], "example": ["Houston, how do you read", "mission control, can you hear me"], "source": "apollo 15 transcript"},
 {"term": "POI", "expansion": "point of interest", "aliases": ["p o i", "pois", "p o i s"], "normalize": true, "category": "navigation", "definition": "a science stop on the traverse where geology and payload tasks happen", "intents": ["Set_navigation_target", "Get_coordinates"], "example": ["take me to POI bravo", "navigate to point of interest bravo"], "source": "mission description 2, 2c"},
 {"term": "lander", "expansion": "lunar lander", "aliases": ["the lm", "l m"], "normalize": false, "category": "navigation", "definition": "the spacecraft the crew lives in; start and end of every EVA", "intents": ["Set_navigation_target", "Get_coordinates"], "example": ["get me back to the lander", "guide me home to the spacecraft"], "source": "mission description 2c"},
 {"term": "PR", "expansion": "pressurized rover", "aliases": ["p r"], "normalize": true, "category": "navigation", "definition": "an enclosed rover crew can ride in without suits", "intents": ["Get_coordinates"], "example": ["where's the PR parked", "where is the pressurized rover"], "source": "mission description 4a.4"},
 {"term": "LTV", "expansion": "lunar terrain vehicle", "aliases": ["l t v"], "normalize": true, "category": "navigation", "definition": "an open unpressurized rover crew drive in suits", "intents": ["Get_coordinates"], "example": ["how far to the LTV", "how far am I from the open rover"], "source": "artemis surface ops"},
 {"term": "rover", "expansion": "rover", "aliases": [], "normalize": false, "category": "navigation", "definition": "surface vehicle used to move between stations", "intents": ["Get_coordinates"], "example": ["rover's down-sun of the crater", "the vehicle is parked with the sun behind it near the crater"], "source": "apollo 15 transcript"},
 {"term": "waypoint", "expansion": "waypoint", "aliases": ["way point"], "normalize": true, "category": "navigation", "definition": "a saved named point on the map", "intents": ["Add_waypoint", "Delete_waypoint"], "example": ["drop a waypoint here, call it ridge", "save this spot on the map as ridge"], "source": "intents.json"},
 {"term": "drop pin", "expansion": "add waypoint", "aliases": ["drop a pin", "drop pin"], "normalize": false, "category": "navigation", "definition": "mark the current spot on the map so you can find it again", "intents": ["Add_waypoint"], "example": ["drop a pin at the boulder", "add a waypoint at the boulder"], "source": "mission description 4a.5"},
 {"term": "breadcrumbs", "expansion": "breadcrumb trail back to the lander", "aliases": ["bread crumbs", "breadcrumb"], "normalize": false, "category": "navigation", "definition": "the recorded path the crew walked, used to retrace steps home", "intents": ["Set_navigation_target"], "example": ["follow the breadcrumbs home", "retrace my path back to the lander"], "source": "mission description 2c ingress, 4a.4"},
 {"term": "traverse", "expansion": "planned route between stations", "aliases": [], "normalize": false, "category": "navigation", "definition": "the walk or drive from one point of interest to the next", "intents": ["Set_navigation_target"], "example": ["start the traverse to station two", "begin the walk to the second stop"], "source": "mission description 2b"},
 {"term": "reroute", "expansion": "calculate a new route", "aliases": ["re route", "re-route"], "normalize": false, "category": "navigation", "definition": "find a different path because the current one is blocked or unsafe", "intents": ["reroute_navigation"], "example": ["reroute, the rille's too steep", "find me another way, this slope is too steep"], "source": "intents.json"},
 {"term": "best path", "expansion": "shortest safe route", "aliases": [], "normalize": false, "category": "navigation", "definition": "the route the planner picks that is short and avoids hazards", "intents": ["reroute_navigation", "Set_navigation_target"], "example": ["give me best path to POI charlie", "find the safest short route to point of interest charlie"], "source": "mission description 4a.4"},
 {"term": "nav", "expansion": "navigation", "aliases": [], "normalize": true, "category": "navigation", "definition": "the map and route guidance on the display", "intents": ["open_menu_navigation"], "example": ["pull up nav", "open the navigation map"], "source": "intents.json"},
 {"term": "nav update", "expansion": "navigation position update", "aliases": [], "normalize": false, "category": "navigation", "definition": "a fresh position fix pushed to the crew's navigation", "intents": ["Get_coordinates"], "example": ["need a nav update", "tell me where I am now"], "source": "apollo 15 transcript"},
 {"term": "coords", "expansion": "coordinates", "aliases": ["co-ords", "cords"], "normalize": true, "category": "navigation", "definition": "the map position of a named place", "intents": ["Get_coordinates"], "example": ["coords for the lander", "what are the coordinates of the lander"], "source": "intents.json"},
 {"term": "bearing", "expansion": "compass direction to a target", "aliases": [], "normalize": false, "category": "navigation", "definition": "which direction to face to reach a place, in degrees", "intents": ["Get_coordinates"], "example": ["what's my bearing to the lander", "which way do I face to reach the lander"], "source": "apollo 15 transcript"},
 {"term": "range", "expansion": "distance to a target", "aliases": [], "normalize": false, "category": "navigation", "definition": "how far away a place is", "intents": ["Get_coordinates"], "example": ["range to station two", "how far is the second stop"], "source": "apollo 15 transcript"},
 {"term": "clicks", "expansion": "kilometers", "aliases": ["klicks"], "normalize": true, "category": "navigation", "definition": "radio slang for kilometers", "intents": [], "example": ["about three clicks out", "roughly three kilometers away"], "source": "apollo 15 transcript"},
 {"term": "max range", "expansion": "predicted maximum range", "aliases": ["walkback limit", "walk back limit"], "normalize": false, "category": "navigation", "definition": "how far the crew can still go and safely get back with remaining consumables", "intents": [], "example": ["what's my walkback limit", "how far can I go and still make it back"], "source": "mission description 4a.4d"},
 {"term": "mini-map", "expansion": "two dimensional map", "aliases": ["mini map", "minimap"], "normalize": false, "category": "display", "definition": "small 2D map on the display showing crew and assets", "intents": ["open_menu_navigation"], "example": ["bring up the mini-map", "show the small map"], "source": "mission description 4a.2"},
 {"term": "UIA", "expansion": "umbilical interface assembly", "aliases": ["u i a", "uya", "you i a", "you eye a"], "normalize": true, "category": "equipment", "definition": "the airlock switch panel that supplies suit power, oxygen and water during egress", "intents": ["open_menu_uia"], "example": ["open the UIA panel", "show the umbilical interface assembly screen"], "source": "mission description 2c, 3b"},
 {"term": "DCU", "expansion": "display and control unit", "aliases": ["d c u"], "normalize": true, "category": "equipment", "definition": "chest box of switches for battery, oxygen, comms, fan, pump and CO2", "intents": [], "example": ["DCU fan to pri", "on the chest switch box, set the fan to primary"], "source": "mission description 3d"},
 {"term": "TSS", "expansion": "telemetry stream server", "aliases": ["t s s"], "normalize": true, "category": "equipment", "definition": "NASA server that streams the simulated suit and equipment readings", "intents": [], "example": ["TSS shows primary at forty seven", "the telemetry feed says primary oxygen is forty seven percent"], "source": "mission description 3a"},
 {"term": "EMU", "expansion": "extravehicular mobility unit", "aliases": ["e m u"], "normalize": true, "category": "equipment", "definition": "the spacesuit itself, including life support", "intents": [], "example": ["EMU power on", "turn on suit power"], "source": "mission description appendix a"},
 {"term": "xEMU", "expansion": "exploration extravehicular mobility unit", "aliases": ["x emu"], "normalize": true, "category": "equipment", "definition": "NASA's newer lunar spacesuit design", "intents": [], "example": ["xEMU suit's holding pressure", "the lunar spacesuit is holding pressure"], "source": "nasa acronyms"},
 {"term": "PLSS", "expansion": "portable life support system", "aliases": ["p l s s", "pliss"], "normalize": true, "category": "equipment", "definition": "the suit backpack that provides oxygen, cooling, CO2 removal and power", "intents": ["get_warnings"], "example": ["give me a PLSS check", "read me the backpack life support status"], "source": "apollo 15 transcript"},
 {"term": "LCVG", "expansion": "liquid cooling and ventilation garment", "aliases": ["l c v g"], "normalize": true, "category": "equipment", "definition": "water-tube underwear that carries heat away from the body", "intents": ["get_coolant_liquid_pressure", "get_temperature"], "example": ["LCVG feels warm", "my cooling garment feels warm"], "source": "nasa acronyms"},
 {"term": "HMD", "expansion": "head mounted display", "aliases": ["h m d"], "normalize": true, "category": "display", "definition": "see-through AR headset showing the interface", "intents": [], "example": ["HMD's too bright", "the headset display is too bright"], "source": "mission description 1"},
 {"term": "HUD", "expansion": "heads up display", "aliases": ["h u d"], "normalize": true, "category": "display", "definition": "overlay in the crew member's view with panels and readouts", "intents": ["close_menu"], "example": ["clear the HUD", "close what's on the display"], "source": "intents.json"},
 {"term": "AR", "expansion": "augmented reality", "aliases": [], "normalize": false, "category": "display", "definition": "graphics drawn over a direct view of the real world", "intents": [], "example": ["AR overlay's drifting", "the graphics over my view are drifting"], "source": "mission description 1"},
 {"term": "XRF", "expansion": "x ray fluorescence spectrometer", "aliases": ["x r f", "xr f", "x-ray"], "normalize": true, "category": "equipment", "definition": "handheld scanner that reads a rock's chemical composition", "intents": [], "example": ["scan it with the XRF", "take a composition reading with the spectrometer"], "source": "mission description 2c, 3c"},
 {"term": "RFID", "expansion": "radio frequency identification tag", "aliases": ["r f i d"], "normalize": true, "category": "equipment", "definition": "tag on each test rock that the spectrometer reads", "intents": [], "example": ["RFID didn't read", "the spectrometer couldn't read the rock's tag"], "source": "mission description 3c"},
 {"term": "PLCD", "expansion": "portable lunar camera deployment", "aliases": ["p l c d", "pcd"], "normalize": true, "category": "procedure", "definition": "procedure to set up the GoPro camera at a point of interest", "intents": ["Complete_task"], "example": ["PLCD complete", "mark the camera setup task as done"], "source": "mission description 2c"},
 {"term": "PLCT", "expansion": "portable lunar camera teardown", "aliases": ["p l c t", "pltc"], "normalize": true, "category": "procedure", "definition": "procedure to pack the camera up before leaving a point of interest", "intents": ["Complete_task"], "example": ["starting PLCT", "beginning the camera pack-up procedure"], "source": "mission description 2c"},
 {"term": "PSMD", "expansion": "physical sample marker deployment", "aliases": ["p s m d"], "normalize": true, "category": "procedure", "definition": "procedure to place a marker where a rock sample was collected", "intents": ["Complete_task"], "example": ["PSMD done at site two", "sample marker placed at the second site"], "source": "mission description 2c"},
 {"term": "GoPro", "expansion": "portable lunar surface camera", "aliases": ["go pro"], "normalize": false, "category": "equipment", "definition": "handheld camera deployed at each point of interest", "intents": [], "example": ["GoPro's streaming", "the surface camera is sending video"], "source": "mission description 3e"},
 {"term": "carry pack", "expansion": "sample carry pack", "aliases": ["sample bag"], "normalize": false, "category": "equipment", "definition": "bag the crew stores collected rocks in", "intents": [], "example": ["sample's in the carry pack", "the rock is stored in my bag"], "source": "mission description 2c"},
 {"term": "seismometer", "expansion": "seismometer", "aliases": [], "normalize": false, "category": "equipment", "definition": "payload that senses ground shaking; deployed at some stations", "intents": ["Complete_task"], "example": ["seismometer's deployed", "mark the seismometer task complete"], "source": "mission description 2c"},
 {"term": "retroreflector", "expansion": "laser retroreflector", "aliases": ["retro reflector"], "normalize": true, "category": "equipment", "definition": "mirror array that bounces lasers back to Earth; must be aligned", "intents": ["Complete_task"], "example": ["retroreflector aligned", "the laser mirror is lined up, mark it done"], "source": "mission description 2c"},
 {"term": "regolith", "expansion": "lunar soil", "aliases": [], "normalize": false, "category": "science", "definition": "loose dust and broken rock covering the moon", "intents": [], "example": ["regolith's packed hard here", "the moon dirt is firm here"], "source": "mission description 2c"},
 {"term": "O2", "expansion": "oxygen", "aliases": ["o two", "o 2", "oh two", "o-2"], "normalize": true, "category": "telemetry", "definition": "the breathing gas stored in the suit tanks", "intents": ["get_oxy_pri_storage", "get_oxy_sec_storage"], "example": ["O2 status", "how much oxygen do I have"], "source": "intents.json"},
 {"term": "CO2", "expansion": "carbon dioxide", "aliases": ["c o two", "co two", "c o 2", "co 2", "c o2", "co-2"], "normalize": true, "category": "telemetry", "definition": "exhaled gas the suit must scrub out", "intents": ["get_suit_pressure_co2", "get_co2_production"], "example": ["CO2's climbing", "carbon dioxide level is going up"], "source": "intents.json"},
 {"term": "ppO2", "expansion": "oxygen partial pressure", "aliases": ["pp o2", "p p o two", "ppo two", "pp o two"], "normalize": true, "category": "telemetry", "definition": "the oxygen share of the suit pressure", "intents": ["get_suit_pressure_oxy"], "example": ["check ppO2", "what's the suit oxygen partial pressure"], "source": "nasa acronyms"},
 {"term": "ppCO2", "expansion": "carbon dioxide partial pressure", "aliases": ["pp co2", "p p c o two", "ppco two", "pp co two"], "normalize": true, "category": "telemetry", "definition": "the CO2 share of the suit pressure", "intents": ["get_suit_pressure_co2"], "example": ["ppCO2 reading", "what's the suit carbon dioxide partial pressure"], "source": "nasa acronyms"},
 {"term": "trace gas", "expansion": "other suit gas pressure", "aliases": ["trace gases"], "normalize": false, "category": "telemetry", "definition": "gases in the suit other than oxygen and CO2", "intents": ["get_suit_pressure_other"], "example": ["trace gas reading", "pressure from the other gases in my suit"], "source": "intents.json"},
 {"term": "pri", "expansion": "primary", "aliases": [], "normalize": true, "category": "telemetry", "definition": "the first of two redundant tanks, fans or batteries", "intents": ["get_oxy_pri_storage", "get_fan_pri_rpm", "get_primary_battery_level"], "example": ["OXY to pri", "switch oxygen to the primary tank"], "source": "mission description 3d"},
 {"term": "sec", "expansion": "secondary", "aliases": [], "normalize": false, "category": "telemetry", "definition": "the backup of two redundant tanks, fans or batteries; not normalized because 'give me a sec' is small talk", "intents": ["get_oxy_sec_storage", "get_fan_sec_rpm", "get_secondary_battery_level"], "example": ["fan sec rpm", "how fast is the secondary fan spinning"], "source": "mission description 3d"},
 {"term": "OXY", "expansion": "oxygen", "aliases": ["oxy"], "normalize": true, "category": "telemetry", "definition": "DCU switch selecting which oxygen tank feeds the suit", "intents": ["get_oxy_pri_storage"], "example": ["verify OXY pri", "check oxygen is set to the primary tank"], "source": "mission description appendix a"},
 {"term": "psi", "expansion": "pounds per square inch", "aliases": ["p s i"], "normalize": false, "category": "telemetry", "definition": "pressure unit for tanks and the suit", "intents": ["get_oxy_pri_pressure", "get_suit_pressure_total"], "example": ["primary tank psi", "what's the primary oxygen tank pressure"], "source": "mission description appendix a"},
 {"term": "suit pressure", "expansion": "total suit pressure", "aliases": ["suit p"], "normalize": false, "category": "telemetry", "definition": "overall gas pressure inside the suit", "intents": ["get_suit_pressure_total"], "example": ["suit pressure holding", "is the total pressure in my suit steady"], "source": "mission description appendix a"},
 {"term": "helmet CO2", "expansion": "helmet carbon dioxide pressure", "aliases": [], "normalize": false, "category": "telemetry", "definition": "CO2 measured near the face inside the helmet", "intents": ["get_helmet_pressure_co2"], "example": ["helmet CO2", "carbon dioxide inside my helmet"], "source": "intents.json"},
 {"term": "fan", "expansion": "ventilation fan", "aliases": [], "normalize": false, "category": "telemetry", "definition": "pushes air through the suit; primary and secondary", "intents": ["get_fan_pri_rpm", "get_fan_sec_rpm"], "example": ["verify FAN pri", "check the primary fan is the one running"], "source": "mission description 3d"},
 {"term": "rpm", "expansion": "revolutions per minute", "aliases": ["r p m", "revs"], "normalize": false, "category": "telemetry", "definition": "fan speed unit", "intents": ["get_fan_pri_rpm", "get_fan_sec_rpm"], "example": ["fan rpm", "how fast is the fan spinning"], "source": "intents.json"},
 {"term": "scrubber A", "expansion": "scrubber a", "aliases": ["scrubber eh", "scrubber ay", "scrubber hey", "scrubber alpha"], "normalize": true, "category": "telemetry", "definition": "first CO2 scrubber canister; DCU 'CO2 A'", "intents": ["get_scrubber_a_co2_storage"], "example": ["scrubber alpha storage", "how full is scrubber a"], "source": "intents.json, mission description 3d"},
 {"term": "scrubber B", "expansion": "scrubber b", "aliases": ["scrubber bee", "scrubber be", "scrubber bravo"], "normalize": true, "category": "telemetry", "definition": "second CO2 scrubber canister; DCU 'CO2 B'", "intents": ["get_scrubber_b_co2_storage"], "example": ["scrubber bravo storage", "how full is scrubber b"], "source": "intents.json, mission description 3d"},
 {"term": "scrubber aco2", "expansion": "scrubber a carbon dioxide", "aliases": ["scrubber a co2"], "normalize": true, "category": "telemetry", "definition": "Whisper often merges 'scrubber A CO2' into one word", "intents": ["get_scrubber_a_co2_storage"], "example": ["scrubber ACO2 storage", "scrubber a carbon dioxide storage"], "source": "onboarding voice test"},
 {"term": "coolant", "expansion": "coolant", "aliases": ["cooling water", "feedwater", "feed water"], "normalize": false, "category": "telemetry", "definition": "water that carries heat out of the suit", "intents": ["get_coolant_storage"], "example": ["feedwater remaining", "how much coolant is left"], "source": "intents.json, apollo 15 transcript"},
 {"term": "coolant gas loop", "expansion": "coolant gas pressure", "aliases": [], "normalize": false, "category": "telemetry", "definition": "gas side of the cooling loop", "intents": ["get_coolant_gas_pressure"], "example": ["gas loop pressure", "coolant gas pressure"], "source": "intents.json"},
 {"term": "coolant liquid loop", "expansion": "coolant liquid pressure", "aliases": [], "normalize": false, "category": "telemetry", "definition": "liquid side of the cooling loop", "intents": ["get_coolant_liquid_pressure"], "example": ["liquid loop pressure", "coolant liquid pressure"], "source": "intents.json"},
 {"term": "temp", "expansion": "temperature", "aliases": [], "normalize": true, "category": "telemetry", "definition": "suit internal temperature", "intents": ["get_temperature"], "example": ["suit temp", "how hot is it in my suit"], "source": "intents.json"},
 {"term": "HR", "expansion": "heart rate", "aliases": ["h r"], "normalize": false, "category": "telemetry", "definition": "crew member's pulse; not normalized because 'hr' also means hour", "intents": ["get_heart_rate"], "example": ["HR check", "what's my heart rate"], "source": "intents.json"},
 {"term": "bpm", "expansion": "beats per minute", "aliases": ["b p m"], "normalize": true, "category": "telemetry", "definition": "heart rate unit", "intents": ["get_heart_rate"], "example": ["what's my bpm", "how many beats per minute is my heart doing"], "source": "intents.json"},
 {"term": "O2 consumption", "expansion": "oxygen consumption rate", "aliases": ["o2 rate", "o2 burn"], "normalize": false, "category": "telemetry", "definition": "how fast the crew member is using oxygen", "intents": ["get_oxy_consumption"], "example": ["what's my O2 burn", "how fast am I using oxygen"], "source": "intents.json"},
 {"term": "CO2 production", "expansion": "carbon dioxide production rate", "aliases": [], "normalize": false, "category": "telemetry", "definition": "how fast the crew member is exhaling CO2", "intents": ["get_co2_production"], "example": ["CO2 production rate", "how much carbon dioxide am I putting out"], "source": "intents.json"},
 {"term": "BATT", "expansion": "battery", "aliases": ["batt", "bat"], "normalize": true, "category": "telemetry", "definition": "suit power source; DCU switch BATT LOCAL or UMB", "intents": ["get_primary_battery_level", "get_secondary_battery_level"], "example": ["batt status", "how much battery do I have"], "source": "mission description 3d"},
 {"term": "UMB", "expansion": "umbilical", "aliases": ["umb"], "normalize": true, "category": "equipment", "definition": "cable from the UIA feeding power and consumables before egress", "intents": [], "example": ["BATT to UMB", "switch the battery to umbilical power"], "source": "mission description appendix a"},
 {"term": "LOCAL", "expansion": "suit battery power", "aliases": [], "normalize": false, "category": "equipment", "definition": "DCU battery switch position that runs the suit on its own battery", "intents": [], "example": ["BATT to LOCAL", "switch to the suit's own battery"], "source": "mission description appendix a"},
 {"term": "COMMS", "expansion": "communications", "aliases": ["comms", "coms"], "normalize": true, "category": "equipment", "definition": "radio channel A or B on the DCU", "intents": [], "example": ["verify COMMS A", "check radio is on channel a"], "source": "mission description 3d"},
 {"term": "PWR", "expansion": "power", "aliases": ["pwr"], "normalize": true, "category": "equipment", "definition": "power switch on the UIA", "intents": [], "example": ["EMU PWR off", "turn suit power off"], "source": "mission description appendix a"},
 {"term": "MET", "expansion": "mission elapsed time", "aliases": ["m e t"], "normalize": false, "category": "telemetry", "definition": "time since the EVA started; not normalized because 'met' is a common word", "intents": ["get_eva_elapsed_time"], "example": ["what's the MET", "how long have we been out"], "source": "nasa acronyms"},
 {"term": "C&W", "expansion": "caution and warning", "aliases": ["c and w", "c&w", "c w"], "normalize": true, "category": "telemetry", "definition": "alert system for off-nominal suit or body readings", "intents": ["get_warnings"], "example": ["any C&W", "do I have any cautions or warnings"], "source": "mission description 4a.6"},
 {"term": "flags", "expansion": "warning flags", "aliases": [], "normalize": false, "category": "telemetry", "definition": "Apollo-era word for active warning indicators", "intents": ["get_warnings"], "example": ["any flags", "are any warnings showing"], "source": "apollo 15 transcript"},
 {"term": "master alarm", "expansion": "active warning", "aliases": [], "normalize": false, "category": "telemetry", "definition": "the top-level alert when something is off-nominal", "intents": ["get_warnings"], "example": ["what tripped the master alarm", "what warning just went off"], "source": "general eva ops"},
