"get_coolant_liquid_pressure": {"means": "coolant liquid loop pressure; also unqualified 'coolant pressure'", "decide": ["liquid", "liquid loop", "liquid side", "water loop", "coolant pressure with no gas/liquid"], "siblings": ["get_coolant_gas_pressure", "get_coolant_storage"], "pos": ["water line psi", "liquid side coolant pressure", "how's the liquid loop holding"], "neg": [["gas side pressure", "get_coolant_gas_pressure"], ["liquid loop looks good", "unhandled"], ["coolant reserve", "get_coolant_storage"]]},
"get_fan_pri_rpm": {"means": "primary fan speed; also unqualified 'fan'", "decide": ["primary/pri/main/fan one", "(fan alone)"], "siblings": ["get_fan_sec_rpm"], "pos": ["main fan revs", "fan one rpm", "how's the fan running"], "neg": [["fan two rpm", "get_fan_sec_rpm"], ["fan pri", "unhandled"], ["the fan's loud", "unhandled"]]},
