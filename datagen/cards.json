"reroute_navigation": {"means": "new route to the current target (no place named)", "decide": ["reroute", "new route/path", "recalculate", "another way"], "siblings": ["Set_navigation_target"], "pos": ["find a way around", "different path", "redo the route"], "neg": [["route me to {place}", "Set_navigation_target"], ["the route looks good", "unhandled"], ["don't reroute", "unhandled"]]},
