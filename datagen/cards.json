{
"get_oxy_pri_storage": {"means": "% oxygen left in the primary tank; also any unqualified oxygen-amount request", "decide": ["primary", "pri", "main", "first", "tank one", "(no qualifier)"], "siblings": ["get_oxy_sec_storage", "get_oxy_pri_pressure", "get_oxy_consumption"], "pos": ["primary o2 how much is in there", "okay what's left of my oxygen", "main tank oxygen percentage"], "neg": [["primary o2 psi", "get_oxy_pri_pressure"], ["copy primary o2 at sixty", "unhandled"], ["how fast is the oxygen dropping", "get_oxy_consumption"]]},
