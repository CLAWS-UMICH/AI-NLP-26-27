"get_primary_battery_level": {"means": "primary battery level; also unqualified 'battery' / 'power'", "decide": ["primary/pri/main/battery one", "(battery alone)"], "siblings": ["get_secondary_battery_level"], "pos": ["main battery charge", "juice left on battery one", "how's my power holding"], "neg": [["battery two charge", "get_secondary_battery_level"], ["batt local", "unhandled"], ["battery's at seventy", "unhandled"]]},
