"get_oxy_consumption": {"means": "rate oxygen is being used", "decide": ["consumption", "use rate", "burn rate", "how fast am i using/going through"], "siblings": ["get_oxy_pri_storage", "get_co2_production"], "pos": ["oxygen usage", "how hard am i pulling on the o2", "o2 per minute right now"], "neg": [["how much o2 is left", "get_oxy_pri_storage"], ["co2 output", "get_co2_production"], ["i'm using a lot of oxygen on this climb", "unhandled"]]},
"get_suit_pressure_oxy": {"means": "oxygen partial pressure inside the suit", "decide": ["ppo2", "oxygen partial pressure", "suit o2 pressure"], "siblings": ["get_suit_pressure_co2", "get_suit_pressure_total", "get_oxy_pri_pressure"], "pos": ["partial o2 in the suit", "what's my suit oxygen partial", "pp o two reading"], "neg": [["o2 tank psi", "get_oxy_pri_pressure"], ["suit pressure overall", "get_suit_pressure_total"], ["ppo2 looks fine", "unhandled"]]},
