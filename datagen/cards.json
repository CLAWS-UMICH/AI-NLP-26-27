"get_eva_elapsed_time": {"means": "time since the eva started", "decide": ["elapsed", "how long", "eva time", "time out"], "siblings": ["get_warnings"], "pos": ["how long has this eva been going", "mission clock", "time since egress"], "neg": [["how much time is left", "unhandled"], ["what time is it in houston", "unhandled"], ["we've been out a while", "unhandled"]]},
