"get_helmet_pressure_co2": {"means": "co2 pressure inside the helmet", "decide": ["helmet + co2/carbon dioxide"], "siblings": ["get_suit_pressure_co2"], "pos": ["co2 in my helmet", "helmet carbon dioxide reading", "how's the co2 up by my face in the helmet"], "neg": [["suit co2", "get_suit_pressure_co2"], ["helmet's fogging up a bit", "unhandled"], ["co2 production", "get_co2_production"]]},
